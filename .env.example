HOST="127.0.0.1" # 127.0.0.1 for localhost only, or 0.0.0.0 for all network interfaces

# Frontend Configuration
FRONTEND_PORT=5173

# Backend Server Configuration
PORT=3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSocket Configuration
MAX_WS_CONNECTIONS=50
WS_PING_INTERVAL_MS=30000

# Server Lifecycle Configuration
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# WPlace API Configuration
WPLACE_BASE=https://backend.wplace.live

# Keep-Alive Configuration
KEEP_ALIVE_INTERVAL_MS=3600000
