{
  "name": "wplacer",
  "version": "5.6.2",
  "main": "dist/server.js",
  "type": "module",
  "author": "JinxTheCatto and luluwaffless",
  "license": "AGPL-3.0-only",
  "funding": "https://ko-fi.com/jinxthecat and https://ko-fi.com/luluwaffless",
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "dev": "concurrently --prefix-colors=blue,green --names=backend,frontend \"npx tsx watch --env-file=.env src/server.ts\" \"npm run dev:frontend\"",
    "dev:backend": "npx tsx watch --env-file=.env src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "gradient-string": "^3.0.0",
    "impit": "0.5.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tough-cookie": "^6.0.0",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
