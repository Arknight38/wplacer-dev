{
  "manifest_version": 3,
  "name": "wplacer",
  "version": "5.6.2",
  "description": "Automatically sends session and Turnstile tokens from wplace.live to a wplacer server.",
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "tabs",
    "scripting",
    "browsingData",
    "offscreen"
  ],
  "host_permissions": [
    "https://wplace.live/",
    "https://backend.wplace.live/",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wplace.live/*"
      ],
      "js": [
        "content-scripts/modules/constants.js",
        "content-scripts/modules/token-handling.js",
        "content-scripts/modules/event-listeners.js",
        "content-scripts/modules/script-injection.js",
        "content-scripts/modules/overlay-bridge.js",
        "content-scripts/modules/periodic-generation.js",
        "content-scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/injected.js",
        "injected/turnstile_inject.js",
        "injected/pawtect_inject.js",
        "injected/overlay_inject.js",
        "offscreen/offscreen.html",
        "solver.wasm/immutable/chunks/*.js",
        "solver.wasm/immutable/chunks/*/*.js",
        "solver.wasm/immutable/*.js",
        "solver.wasm/immutable/assets/*.wasm",
        "solver.wasm/pawtect_wasm_bg.*.wasm",
        "solver.wasm/pawtect_wasm_bg.wasm"
      ],
      "matches": ["https://wplace.live/*"]
    }
  ]
}
